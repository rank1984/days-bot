from typing import Dict, Any


def calculate_scores(candidate: Dict[str, Any]) -> Dict[str, Any]:
    """
    V2.3 Event Engine - Calculates total event score with heavy weight on Previous Day Momentum
    and Volume Building, penalizing over-extended runners.
    """
    # 1. Previous Day Momentum Score
    prev_gain = candidate.get('prev_gain', 0.0)
    prev_rvol = candidate.get('prev_rvol', 0.0)

    if prev_gain >= 8.0 and prev_rvol >= 3.0:
        prev_momentum_score = 20
    elif prev_gain >= 5.0 and prev_rvol >= 2.0:
        prev_momentum_score = 10
    else:
        prev_momentum_score = 0

    # 2. Previous Day RVOL Score
    if prev_rvol >= 5.0:
        prev_rvol_score = 15
    elif prev_rvol >= 3.0:
        prev_rvol_score = 10
    elif prev_rvol >= 2.0:
        prev_rvol_score = 5
    else:
        prev_rvol_score = 0

    # 3. Current Day RVOL Score
    rvol = candidate.get('rvol', 0.0)
    if rvol >= 50.0:
        rvol_score = 15
    elif rvol >= 20.0:
        rvol_score = 12
    elif rvol >= 10.0:
        rvol_score = 8
    elif rvol >= 5.0:
        rvol_score = 5
    else:
        rvol_score = 0

    # 4. Share Float Score
    float_shares = candidate.get('float_shares', None)
    if float_shares is not None and float_shares > 0:
        if float_shares < 5_000_000:
            float_score = 15
        elif float_shares < 10_000_000:
            float_score = 12
        elif float_shares < 20_000_000:
            float_score = 8
        elif float_shares < 50_000_000:
            float_score = 5
        else:
            float_score = 0
    else:
        float_score = 0

    # 5. Today Gap Score (Diminishing return / Penalty for huge gap)
    gap = candidate.get('gap_pct', 0.0)
    if gap < 3.0:
        gap_score = 0
    elif gap < 5.0:
        gap_score = 5
    elif gap < 10.0:
        gap_score = 8
    elif gap < 18.0:
        gap_score = 10
    elif gap < 25.0:
        gap_score = 8
    else:
        gap_score = 5  # Penalty for over-extended gap (>25%)

    # 6. Volume Building Score
    vol_building_score = 10 if candidate.get('volume_building', False) else 0

    # 7. Catalyst Score
    catalyst_score = candidate.get('catalyst_score', 0)

    # 8. Liquidity / Spread Score
    spread = candidate.get('spread_pct', 0.0)
    if spread <= 1.0:
        liquidity_score = 5
    elif spread <= 2.0:
        liquidity_score = 3
    else:
        liquidity_score = 0

    # Calculate Total
    total = (
        prev_momentum_score +
        prev_rvol_score +
        rvol_score +
        float_score +
        gap_score +
        vol_building_score +
        catalyst_score +
        liquidity_score
    )

    event_score = min(100, max(0, total))

    # Grade Classification
    if event_score >= 80:
        grade = "A+"
    elif event_score >= 70:
        grade = "A"
    elif event_score >= 55:
        grade = "B"
    elif event_score >= 40:
        grade = "C"
    else:
        grade = "D"

    updated_candidate = dict(candidate)
    updated_candidate['event_score'] = event_score
    updated_candidate['grade'] = grade

    return updated_candidate
